# Copy this file, rename the copy to ".env" (same folder as server.js) and fill it in.
# The server reads .env automatically when it starts. Never share or upload your .env file.
JWT_SECRET=change-me-to-a-long-random-string
PORT=3000
# Public address of your site. Used for the links inside emails.
APP_URL=http://localhost:3000

# ---- Email ----
# Leave SMTP_HOST empty to stay in DEV mode (emails are only saved to the Email log, nothing is sent).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=StudentSphere <yourname@gmail.com>

# ---- Supabase official student roster ----
# Keep the service-role key on the backend only. NEVER put it in public/js or Netlify variables.
SUPABASE_URL=https://vzbuevjvgyocxzcnwkbs.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ROSTER_TABLE=student_roster
SUPABASE_ROSTER_ID_COLUMNS=studentid,student_id,university_id

# ---- Production / student list ----
# NODE_ENV=production            (refuses to start without JWT_SECRET)
# DB_FILE=/var/data/studentsphere.db   UPLOAD_DIR=/var/data/uploads   (put both on a persistent disk)
# SEED_DEMO=false                (no demo accounts; creates one admin from the two lines below, first start only)
# ADMIN_EMAIL=you@africau.edu
# ADMIN_PASSWORD=a-long-unique-password
# TRUST_PROXY=2                  (1 if users hit the backend directly, 2 when Netlify sits in front of Render)
# REQUIRE_ROSTER=true            (only students on the Supabase roster can register)
# AUTO_APPROVE_ROSTER=false      (true = listed students are activated immediately, see DEPLOY.md before enabling)
