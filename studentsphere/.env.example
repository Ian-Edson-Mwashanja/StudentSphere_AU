# StudentSphere PostgreSQL configuration
# Copy this file to .env and enter your private values.
# Never commit or share your actual .env file.

NODE_ENV=development
PORT=3000

# Supabase PostgreSQL
DATABASE_URL=

# Authentication
JWT_SECRET=replace-with-a-long-random-secret

# Uploaded achievement files
UPLOAD_DIR=uploads

# Public application address
APP_URL=http://localhost:3000

# Email configuration
MAIL_MODE=dev
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=StudentSphere <yourname@gmail.com>
